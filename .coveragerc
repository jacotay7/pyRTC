[run]
# Measure the whole package. Name the package, not dotted submodules:
# --cov=pyrtc.<module> makes coverage import pyrtc early and numpy is then
# imported a second time, which breaks numpy's internal sentinels.
source = pyrtc
omit =
    # Qt windows that need a display; their logic lives in manager_adapter.py
    # and viewer_helpers.py, which are measured.
    pyrtc/gui/main_window.py
    pyrtc/scripts/viewer_core.py

[report]
exclude_lines =
    if __name__ == .__main__.
